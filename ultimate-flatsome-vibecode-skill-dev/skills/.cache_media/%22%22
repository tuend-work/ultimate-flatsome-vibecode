    <script>
    (function () {
        var root = document.getElementById('premium-faq-section');
        if (!root) return;

        var items = root.querySelectorAll('.fq-item');

        /* Cột trái dùng position: sticky. Sticky sẽ mất tác dụng nếu bất kỳ thẻ cha
           nào có overflow: hidden (rất phổ biến ở theme WordPress). Đổi các thẻ đó
           sang overflow: clip — vẫn cắt nội dung tràn y hệt nhưng không chặn sticky. */
        (function fixStickyAncestors() {
            var node = root.parentElement;
            while (node && node !== document.documentElement) {
                var st = getComputedStyle(node);
                if (st.overflowX === 'hidden') node.style.overflowX = 'clip';
                if (st.overflowY === 'hidden') node.style.overflowY = 'clip';
                node = node.parentElement;
            }
        })();

        function collapse(item) {
            var ans = item.querySelector('.fq-answer');
            ans.style.maxHeight = ans.scrollHeight + 'px';
            void ans.offsetHeight;
            ans.style.maxHeight = '0px';
            item.classList.remove('active');
            item.querySelector('.fq-question').setAttribute('aria-expanded', 'false');
        }

        function expand(item) {
            var ans = item.querySelector('.fq-answer');
            ans.style.maxHeight = ans.scrollHeight + 'px';
            item.classList.add('active');
            item.querySelector('.fq-question').setAttribute('aria-expanded', 'true');
        }

        items.forEach(function (item) {
            var btn = item.querySelector('.fq-question');
            btn.addEventListener('click', function () {
                var isOpen = item.classList.contains('active');
                items.forEach(function (other) {
                    if (other.classList.contains('active')) collapse(other);
                });
                if (!isOpen) expand(item);
            });
        });

        // Mở sẵn câu hỏi đầu tiên
        var first = root.querySelector('.fq-item.active');
        if (first) expand(first);

        var moreBtn  = root.querySelector('.fq-more');
        var moreText = root.querySelector('.fq-more-text');

        var LIMIT = 6;              /* số câu hiện sẵn trước khi bấm "Xem thêm" */
        var expanded = false;       /* đã bấm xem thêm hay chưa */

        items.forEach(function (item, i) {
            var badge = item.querySelector('.fq-num');
            if (badge) badge.textContent = (i + 1 < 10 ? '0' : '') + (i + 1);
        });

        function applyClip() {
            var hiddenCount = 0;

            items.forEach(function (item, i) {
                var clipped = (!expanded && i >= LIMIT);
                item.classList.toggle('is-clipped', clipped);
                if (clipped) {
                    hiddenCount++;
                    item.classList.remove('is-entering');
                } else if (expanded && i >= LIMIT) {
                    void item.offsetWidth;      /* ép trình duyệt chạy lại animation */
                    item.classList.add('is-entering');
                }
            });

            if (items.length > LIMIT) {
                moreBtn.classList.add('is-visible');
                moreBtn.classList.toggle('is-open', expanded);
                moreBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                moreText.textContent = expanded
                    ? 'Thu gọn'
                    : 'Xem thêm ' + hiddenCount + ' câu hỏi';
            } else {
                moreBtn.classList.remove('is-visible', 'is-open');
            }
        }

        moreBtn.addEventListener('click', function () {
            expanded = !expanded;
            applyClip();
            if (!expanded) {
                var list = root.querySelector('.fq-list');
                if (list) {
                    var top = list.getBoundingClientRect().top + window.pageYOffset - 110;
                    window.scrollTo({ top: top, behavior: 'smooth' });
                }
            }
        });

        applyClip();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                var open = root.querySelector('.fq-item.active .fq-answer');
                if (open) open.style.maxHeight = open.scrollHeight + 'px';
            }, 150);
        });
    })();
    </script>
