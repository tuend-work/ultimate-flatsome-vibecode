        var items    = root.querySelectorAll('.wu-tab-item');
        var images   = root.querySelectorAll('.wu-image-wrap img');
        var wrap     = root.querySelector('.wu-image-wrap');
        var lightbox = root.querySelector('#wuLightbox');
