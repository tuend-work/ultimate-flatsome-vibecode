    <script>
    (function () {
        var root = document.getElementById('premium-malware-classic');
        if (!root) return;

        var cards    = Array.prototype.slice.call(root.querySelectorAll('.mc-card'));
        var lightbox = root.querySelector('.mc-lightbox');
        var lbImg    = root.querySelector('.mc-lb-img');
        var lbSign   = root.querySelector('.mc-lb-sign');
        var lbCap    = root.querySelector('.mc-lb-caption');
        var lbCount  = root.querySelector('.mc-lb-counter');
        var btnClose = root.querySelector('.mc-close-btn');
        var btnPrev  = root.querySelector('.mc-prev-btn');
        var btnNext  = root.querySelector('.mc-next-btn');

        var shots = [];      /* bộ ảnh của dấu hiệu đang mở */
        var signName = '';
        var current = 0;

        /* Ảnh đại diện + các ảnh minh chứng ẩn của cùng một dấu hiệu */
        function shotsOf(card) {
            var list = [card.querySelector('.mc-thumb > img')];
            Array.prototype.forEach.call(
                card.querySelectorAll('.mc-evidence img'),
                function (img) { list.push(img); }
            );
            return list.filter(Boolean);
        }

        function render() {
            var img = shots[current];
            if (!img) return;
            lbImg.src = img.getAttribute('src');
            lbImg.alt = img.getAttribute('alt') || '';
            lbSign.textContent = signName;
            lbCap.textContent = img.getAttribute('data-caption') || '';
            /* Chỉ một ảnh thì giấu bộ đếm và hai mũi tên cho đỡ rối */
            var single = shots.length < 2;
            lbCount.textContent = single ? '' : (current + 1) + ' / ' + shots.length;
            btnPrev.style.display = single ? 'none' : '';
            btnNext.style.display = single ? 'none' : '';
        }

        function open(card) {
            shots = shotsOf(card);
            signName = card.querySelector('.mc-card-title').textContent.trim();
            current = 0;
            render();
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
            btnClose.focus();
        }

        function step(delta) {
            if (!shots.length) return;
            current = (current + delta + shots.length) % shots.length;
            render();
        }

        function close() {
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
        }

        cards.forEach(function (card) {
            card.addEventListener('click', function () { open(card); });
            card.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    open(card);
                }
            });
        });

        btnClose.addEventListener('click', close);
        btnPrev.addEventListener('click', function (e) { e.stopPropagation(); step(-1); });
        btnNext.addEventListener('click', function (e) { e.stopPropagation(); step(1); });
        lightbox.addEventListener('click', function (e) { if (e.target === lightbox) close(); });

        document.addEventListener('keydown', function (e) {
            if (!lightbox.classList.contains('active')) return;
            if (e.key === 'Escape') close();
            if (e.key === 'ArrowRight') step(1);
            if (e.key === 'ArrowLeft') step(-1);
        });
    })();
    </script>
