}</style><button id="crystal-scroll-btn" class="crystal-wrapper" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
    <div class="crystal-bg"></div>
    <div class="crystal-content">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="17 11 12 6 7 11"></polyline>
            <polyline points="17 18 12 13 7 18"></polyline>
        </svg>
    </div>
</button>

<style>
/* Cấu hình mặc định cho PC */
.crystal-wrapper {
    position: fixed;
    bottom: 30px; 
    left: -80px; 
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    cursor: pointer;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.crystal-wrapper.is-active {
    left: 15px; 
}

/* ĐIỀU CHỈNH RIÊNG CHO MOBILE */
@media (max-width: 767px) {
    .crystal-wrapper {
        bottom: 70px; /* Tăng thêm 20px so với mức 30px ban đầu */
    }
    .crystal-wrapper.is-active {
        left: 10px; /* Cách mép trái 10px (5px cũ + 5px mới) */
    }
}

.crystal-content {
    color: #444;
    z-index: 2;
    display: flex;
    transition: color 0.3s ease;
}

.crystal-content svg {
    width: 22px;
    height: 22px;
}

.crystal-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    opacity: 0;
    z-index: 1;
}

.crystal-wrapper:hover .crystal-content {
    color: #273647;
}

.crystal-wrapper:active {
    transform: scale(0.9);
}
</style>

<script>
(function() {
    const btn = document.getElementById("crystal-scroll-btn");
    let isScrolling;

    window.addEventListener("scroll", function() {
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPos = window.pageYOffset || document.documentElement.scrollTop;
        
        // Kiểm tra điều kiện vị trí để hiện nút
        if (height > 0 && scrollPos > (height / 2)) {
            btn.classList.add("is-active");
            
            // Xóa bộ đếm thời gian cũ nếu đang cuộn
            window.clearTimeout(isScrolling);

            // Thiết lập bộ đếm thời gian: sau 2 giây không cuộn sẽ ẩn nút
            isScrolling = setTimeout(function() {
                btn.classList.remove("is-active");
            }, 2000); 
        } else {
            btn.classList.remove("is-active");
        }
    });
})();
</script><div class="rd-progress-container">
    <div id="rd-progress-bar"></div>
</div>

<style>
/* Định dạng thanh tiến trình */
.rd-progress-container {
    position: fixed;
    bottom: 0; 
    left: 0;
    width: 100%;
    /* Mặc định cho Mobile là 2px */
    height: 2px; 
    background: rgba(255, 255, 255, 0.1); 
    z-index: 999999; 
    pointer-events: none; 
}

/* Điều chỉnh riêng cho PC (màn hình từ 768px trở lên) */
@media (min-width: 768px) {
    .rd-progress-container {
        height: 4px;
    }
}

#rd-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(to right, #4facfe 0%, #00f2fe 50%, #7028e4 100%);
    box-shadow: 0 0 8px rgba(79, 172, 254, 0.7);
    transition: width 0.15s ease-out; 
}
</style>

<script>
(function() {
    function updateBar() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        
        const bar = document.getElementById("rd-progress-bar");
        if (bar) {
            bar.style.width = scrolled + "%";
        }
    }

    window.addEventListener('scroll', updateBar);
    window.addEventListener('DOMContentLoaded', updateBar);
})();
</script><div id="welcome-popup" class="premium-popup">
    <div class="popup-inner">
        <div class="icon-wrapper">
            <span class="main-icon">👋</span>
            <div class="pulse-ring"></div>
        </div>
        <div class="text-content">
            <p>
                <span class="popup-title">Xin chào!</span> 
                <span class="old-style-text">Cảm ơn bạn</span>
            </p>
            <p class="old-style-text">đã ghé thăm Blog của tôi.</p>
        </div>
        <button id="close-popup" class="premium-close">&times;</button>
    </div>
</div>

<style>
/* CSS: Giữ nguyên thiết kế và hiệu ứng của bạn */
.premium-popup {
    position: fixed;
    bottom: 30px;
    left: -500px; 
    width: auto;
    z-index: 999999;
    transition: all 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.premium-popup.show-now {
    left: 5px;
}

.popup-inner {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px; 
    padding: 10px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
}

.icon-wrapper {
    position: relative;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
}

.main-icon {
    position: relative;
    z-index: 2;
    font-size: 20px;
    background: #fdfdfd;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
}

.pulse-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #6e8efb;
    border-radius: 8px;
    opacity: 0.4;
    animation: pulse-ring-anim 2s infinite;
}

@keyframes pulse-ring-anim {
    0% { transform: scale(0.8); opacity: 0.5; }
    100% { transform: scale(1.4); opacity: 0; }
}

.text-content {
    display: flex;
    flex-direction: column;
    gap: 0px;
}

.text-content p {
    margin: 0;
    white-space: nowrap;
    line-height: 1.2;
}

.popup-title {
    font-weight: 700;
    color: #222;
    font-size: 16px;
    margin-right: 4px;
}

.old-style-text {
    font-size: 14.5px;
    color: #888;
    font-weight: 500;
}

.premium-close {
    position: absolute;
    top: 5px;
    right: 8px;
    border: none;
    background: none;
    font-size: 18px;
    color: #ccc;
    cursor: pointer;
    line-height: 1;
}

.premium-close:hover { color: #ff4757; }

@keyframes wave-hand {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(15deg); }
    75% { transform: rotate(-10deg); }
}
.show-now .main-icon {
    animation: wave-hand 1s ease-in-out 2;
}
</style>

<script>
// Logic: Chỉ hiển thị 1 lần bằng localStorage
document.addEventListener("DOMContentLoaded", function() {
    const popup = document.getElementById("welcome-popup");
    const closeBtn = document.getElementById("close-popup");

    // Kiểm tra xem trình duyệt đã lưu dấu "đã xem" chưa
    const hasSeenPopup = localStorage.getItem("hasSeenWelcomePopup");

    if (!hasSeenPopup) {
        setTimeout(function() {
            popup.classList.add("show-now");
            
            // Lưu dấu vào trình duyệt để lần sau không hiện nữa
            localStorage.setItem("hasSeenWelcomePopup", "true");
            
            // Tự động đóng sau 5 giây
            setTimeout(function() {
                popup.classList.remove("show-now");
            }, 10000);
            
        }, 500);
    }

    closeBtn.onclick = function() {
        popup.classList.remove("show-now");
    };
});
</script><style class="wpcode-css-snippet">/* --- TỐI ƯU CỘT DANH MỤC BÊN TRÁI --- */
#navigation .penci-megamenu .penci-mega-child-categories {
    padding: 0 !important;
    background-color: #ffffff; /* Nền trắng tinh khôi làm nổi bật mục Active */
    border-right: 1px solid #f0f0f0;
    min-width: 220px; /* Đảm bảo độ rộng hợp lý */
}

#navigation .penci-megamenu .penci-mega-child-categories a {
    display: block;
    text-align: left; /* Căn trái tuyệt đối */
    padding: 16px 25px;
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #555; /* Màu chữ trung tính hiện đại */
    border: none !important;
    position: relative;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow: hidden;
}

/* HIỆU ỨNG GRADIENT ACTIVE - MẠNH MẼ & SANG TRỌNG */
#navigation .penci-megamenu .penci-mega-child-categories a.cat-active {
    /* Gradient loang từ màu Accent sang tông Dark cực sang */
    background: linear-gradient(135deg, var(--pcaccent-cl) 0%, #111111 160%) !important;
    color: #ffffff !important;
    font-weight: 700;
    
    /* Hiệu ứng bóng đổ khối để tách biệt với phần nội dung trắng */
    box-shadow: 6px 0 20px rgba(0, 0, 0, 0.15);
    z-index: 10;
    
    /* Loại bỏ hoàn toàn bo góc theo yêu cầu phẳng sát mép */
    border-radius: 0;
}

/* HIỆU ỨNG HOVER CHO CÁC MỤC CHƯA CHỌN */
#navigation .penci-megamenu .penci-mega-child-categories a:hover:not(.cat-active) {
    background-color: #f9f9f9;
    color: var(--pcaccent-cl);
    padding-left: 35px; /* Hiệu ứng trượt nhẹ sang phải đặc trưng của UI cao cấp */
}

/* ĐƯỜNG KẺ MỜ PHÂN TÁCH GIỮA CÁC MỤC (Tùy chọn để tăng sự ngay ngắn) */
#navigation .penci-megamenu .penci-mega-child-categories a:not(:last-child) {
    border-bottom: 1px solid #f7f7f7 !important;
}

/* --- ĐIỀU CHỈNH BẢNG NỘI DUNG (GIỮ NGUYÊN NHƯNG LÀM THOÁNG HƠN) --- */
#navigation .penci-megamenu .penci-content-megamenu {
    background-color: #ffffff !important;
    padding: 25px !important;
    border-left: none; /* Xóa viền cũ nếu có để nối liền với menu trái */
}</style><style class="wpcode-css-snippet">.container-single .post-entry .post-tags a {
    text-transform: uppercase;
    color: #ffffff;
    padding: 6px 14px;
    margin-right: 8px;
    margin-bottom: 8px;
    display: inline-block;
    font-size: 11px !important;
    /* Gradient thiên về xanh dương: từ xanh dương trung tính sang xanh da trời sáng */
    background: linear-gradient(135deg, #4776E6, #8E54E9); /* Bạn có thể thử cặp này nếu muốn hơi ánh tím */
    /* Hoặc cặp thuần xanh dương dịu dưới đây: */
    background: linear-gradient(135deg, #2193b0, #6dd5ed); 
    border: none;
    border-radius: 4px; 
    transition: all 0.3s ease;
    -webkit-transition: all 0.3s ease;
    -moz-transition: all 0.3s ease;
    outline: none;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(33, 147, 176, 0.2);
}

/* Hiệu ứng khi di chuột vào (Hover) */
.container-single .post-entry .post-tags a:hover {
