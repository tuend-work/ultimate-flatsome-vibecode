}</style><style class="wpcode-css-snippet">/* 1. Ẩn hoàn toàn dấu chấm mặc định của danh sách */
.post-entry ul, 
.elementor-text-editor ul, 
.woocommerce .page-description ul {
    list-style: none !important; /* Quan trọng: Loại bỏ dấu chấm đen */
    list-style-type: none !important;
    padding-left: 36px;
}

/* 2. Đảm bảo các thẻ li không tự sinh lại dấu chấm */
.post-entry ul li, 
.elementor-text-editor ul li, 
.woocommerce .page-description ul li {
    list-style: none !important;
    list-style-type: none !important;
    position: relative;
}

/* 3. Chỉnh sửa lại icon :before để không bị dính nền xanh và căn chỉnh chuẩn */
.post-entry ul li:before, 
.elementor-text-editor ul li:before, 
.woocommerce .page-description ul li:before {
    content: "\f064";
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    position: absolute;
    left: -25px;
    top: 0; /* Căn chỉnh theo chiều dọc */
    color: #425d7b;
    background: none !important; /* Xử lý triệt để bôi xanh */
    padding: 0 !important;
}</style><style>
/* Giữ nguyên tuyệt đối style và các tính năng có sẵn của bạn */
.box_fixRight {
    position: fixed;
    top: 260px;
    right: -105px; 
    width: auto;
    transition: all 0.2s ease-in-out 0s;
    z-index: 999;
}
.box_fixRight .box_content {
    background: #fff;
    padding: 5px 10px 5px 10px;
    box-shadow: 10px 0px 30px #888888;
    border-radius: 10px 0 0 10px;
}
.box_fixRight .box_content .item {
    display: block;
    padding: 13px 10px 13px 47px;
    color: #111;
    text-decoration: none;
    transition: color 0.2s;
}
.box_fixRight .box_content .item:hover {
    color: #184b9b;
    animation: simpleWobble 0.4s ease;
}
@keyframes simpleWobble {
    0% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    50% { transform: translateX(2px); }
    75% { transform: translateX(-2px); }
    100% { transform: translateX(0); }
}
.box_fixRight .box_content .item.item_1 { background: url(https://damtrungkien.com//wp-content/uploads/2024/07/fb35x35.png) no-repeat left center; }
.box_fixRight .box_content .item.item_2 { background: url(https://damtrungkien.com//wp-content/uploads/2024/07/mess-35x35-1.png) no-repeat left center; }
.box_fixRight .box_content .item.item_3 { background: url(https://damtrungkien.com//wp-content/uploads/2024/07/telegram-35x35-1.png) no-repeat left center; }
.box_fixRight .box_content .item.item_4 { background: url(https://damtrungkien.com//wp-content/uploads/2024/07/zalo-35x35-1.png) no-repeat left center; }

.box_fixRight:hover { right: 0; }

@media (max-width: 549px) {
    .box_fixRight {display: none;}
}
</style>

<div class="box_fixRight">
    <div class="box_content">
        <a href="https://fb.com/dtk.95" target="_blank" class="item item_1">Facebook</a>
        <a href="https://m.me/dtk.95" target="_blank" class="item item_2">Messenger</a>
        <a href="http://t.me/damtrungkien" target="_blank" class="item item_3">Telegram</a>
        <a href="zalo://conversation?phone=0908383403" class="item item_4" id="zalo_btn">Zalo</a>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var zaloBtn = document.getElementById('zalo_btn');
    var sdt = "0908383403";
    var qrId = "1u8kzao0zl66o"; // Mã QR định danh của Kiên

    zaloBtn.addEventListener('click', function(e) {
        var userAgent = navigator.userAgent || navigator.vendor || window.opera;
        
        // Nếu là thiết bị di động
        if (/android|iphone|ipad|ipod/i.test(userAgent)) {
            e.preventDefault();
            var deepLink = /iphone|ipad|ipod/i.test(userAgent) 
                           ? 'zalo://qr/p/' + qrId 
                           : 'zalo://zaloapp.com/qr/p/' + qrId;
            window.location.href = deepLink;
            
            // Nếu không có app, chuyển sang link web dự phòng sau 2 giây
            setTimeout(function() {
                window.location.href = 'https://zalo.me/' + sdt;
            }, 2000);
        } 
        // Nếu là PC, link zalo://conversation?phone= sẽ tự kích hoạt ứng dụng Zalo PC
    });
});
</script><style class="wpcode-css-snippet">/* Ẩn icon search trên PC (màn hình lớn hơn 1024px) */
