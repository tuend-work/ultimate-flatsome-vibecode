			<div class="elementor-widget-wrap elementor-element-populated">
						<div class="elementor-element elementor-element-3897930 elementor-widget elementor-widget-html" data-id="3897930" data-element_type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<div id="terminal-v404-container">
    <style>
        /* Chỉ tác động vào các thành phần bên trong #terminal-v404-container */
        #terminal-v404-container .terminal-wrapper-pro {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: auto; 
            padding: 0px 0px 40px;
            width: 100%;
            font-family: 'JetBrains Mono', 'Fira Code', monospace;
            margin: 0;
            box-sizing: border-box;
        }

        #terminal-v404-container .terminal-title-external {
            color: #273647;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 25px;
            letter-spacing: 3px;
            text-shadow: 0 0 5px rgba(39, 54, 71, 0.2); 
            white-space: nowrap;
            overflow: hidden;
            border-right: 3px solid #273647;
            width: 0;
            animation: 
                typing-v404 2.5s steps(20, end) forwards,
                blink-caret-v404 .75s step-end infinite;
        }

        @keyframes typing-v404 {
            from { width: 0 }
            to { width: 100% }
        }

        @keyframes blink-caret-v404 {
            from, to { border-color: transparent }
            50% { border-color: #273647 }
        }

        #terminal-v404-container .terminal-card-pro {
            width: 550px;
            max-width: 95%;
            background: #273647;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2), 0 30px 60px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease;
            box-sizing: border-box;
        }

        #terminal-v404-container .terminal-card-pro:hover {
            transform: translateY(-5px);
        }

        #terminal-v404-container .mac-header-pro {
            background: rgba(0, 0, 0, 0.15);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            box-sizing: border-box;
        }

        #terminal-v404-container .dots-pro {
            display: flex;
            gap: 10px;
        }

        #terminal-v404-container .dot-pro {
            width: 13px;
            height: 13px;
            border-radius: 50%;
        }

        #terminal-v404-container .d-red { background: #ff5f56; }
        #terminal-v404-container .d-yellow { background: #ffbd2e; }
        #terminal-v404-container .d-green { background: #27c93f; }

        #terminal-v404-container .mac-title-pro {
            flex: 1;
            text-align: center;
