<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TweenMax.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TimelineMax.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script>
    //custom search box


$(document).ready(function(){
  
  
    var tl = new TimelineMax();

   $('.search-box .icon-wrap').click(function() {
        var $this = $(this);
        var $form = $('.search-box form');

        if ($this.hasClass('open')) {
            // Nếu đã có lớp 'open', thì xóa lớp và điều chỉnh kiểu dáng
            $this.removeClass('open');
            $form.css('left', '100%');

            // Thay đổi kích thước và kiểu dáng của icon-wrap
            tl.clear(); // Xóa tất cả các hành động trước đó
            tl.to($this, 0.3, {css: {width: '40px', boxShadow: '0px 6px 6px rgba(0,0,0,.28)'}});
            tl.to($this, 0.3, {css: {borderRadius: '50%'}}, '-=0.2');
            TweenMax.to('.search-box svg', 0.3, {fill: '#000', rotation: 0});
            TweenMax.to('.search-box input, .search-box label', 0.3, {width: 0});
            
            // Phát TimelineLite
            tl.play();

        } else {
            // Nếu không có lớp 'open', thì thêm lớp và điều chỉnh kiểu dáng
            $this.addClass('open');
            $form.css('left', '50%');

            // Thay đổi kích thước và kiểu dáng của icon-wrap
            tl.clear(); // Xóa tất cả các hành động trước đó
            tl.to($this, 0.7, {
                css: {
                    borderRadius: '20px',
                    width: '400px',
                    boxShadow: 'rgba(0, 0, 0, 0.28) -3px 16px 52px 0px'
                },
                ease: Elastic.easeOut.config(1, 0.7)
            });
            TweenMax.to('.search-box svg', 0.3, {fill: '#737272', rotation: '90deg'});
            TweenMax.to('.search-box input', 0.3, {width: '81%'});
            TweenMax.to('.search-box label', 0.3, {width: '78%'});
            
            // Phát TimelineLite
            tl.play();
        }
    });

    $('input').focus(function() {
        $('.search-box .label-wrap').animate({opacity: 0},100);
    });
    $('input').blur(function() {
        if(!$(this).val() == '') {
            $('.search-box .label-wrap').animate({opacity: 0},100);
        } else {
            $('.search-box .label-wrap').animate({opacity: 1},1200);
        }
    });
});
    </script>
