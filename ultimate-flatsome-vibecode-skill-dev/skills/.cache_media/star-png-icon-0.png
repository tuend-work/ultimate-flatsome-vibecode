    display: none;
}
.penci-border-arrow.penci-homepage-title:after {
    border-color: #ffffff;
}

/* 2. Định dạng chữ và ÉP XÓA tất cả các vệt xanh dương mặc định */
.penci-border-arrow.penci-homepage-title.penci-magazine-title.style-4 h3,
