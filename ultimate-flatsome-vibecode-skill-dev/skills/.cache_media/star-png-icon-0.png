    <style>
        .dtk-modal { position: fixed; inset: 0; z-index: 999999; display: none; align-items: center; justify-content: center; font-family: -apple-system, sans-serif; padding: 20px; }
        .dtk-modal-overlay { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px); }
        .dtk-modal-container { position: relative; width: 100%; max-width: 800px; background: #fff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.15); }
        .dtk-modal-header { display: flex; align-items: center; padding: 15px 20px; border-bottom: 1px solid #f1f5f9; }
        .dtk-search-icon, .dtk-header-actions span { display: flex; align-items: center; justify-content: center; }
        #dtk-search-input { flex: 1; border: none; outline: none; font-size: 16px; padding: 0 12px; color: #334155; line-height: normal; background: transparent; }
        .dtk-header-actions { display: flex; align-items: center; gap: 12px; color: #94a3b8; }
        .dtk-modal-body { flex: 1; display: flex; flex-direction: column; }
        .dtk-placeholder-wrapper { padding: 30px 25px; }
        .dtk-initial-view { text-align: center; margin-bottom: 30px; color: #94a3b8; }
        .dtk-initial-view p { margin-top: 10px; font-size: 14px; }
        .tag-label { display: block; font-size: 11px; color: #94a3b8; font-weight: 700; margin-bottom: 15px; }
        .tags-list { display: flex; flex-wrap: wrap; gap: 10px; }
        .dtk-tag-text { font-size: 13px; color: #475569; padding: 6px 16px; cursor: pointer; border-radius: 8px; border: 1px solid #e2e8f0; transition: 0.2s; background: #fff; }
        .dtk-tag-text:hover { border-color: #3b82f6; color: #3b82f6; background: #f0f7ff; }
        #dtk-results-wrapper { min-height: 400px; max-height: 70vh; flex-direction: row; border-top: 1px solid #f1f5f9; }
        .dtk-results-main { flex: 2; border-right: 1px solid #f1f5f9; overflow-y: auto; }
        .dtk-results-sidebar { flex: 1; background: #fafafa; padding: 20px; overflow-y: auto; }
        .search-post-item { display: block; padding: 12px 20px; text-decoration: none !important; border-bottom: 1px solid #f8fafc; transition: opacity 0.2s; }
        .search-post-item:hover { background: #f8fafc; }
        .dtk-search-post-title { display: block; font-size: 15px; color: #1e293b; margin-top: 4px; font-weight: 500; }
        .dtk-highlight { color: #3b82f6; font-weight: 600; }
        .dtk-sidebar-inner { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 15px; }
        .dtk-stat-box { display: flex; align-items: center; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; margin-bottom: 12px; font-size: 14px; color: #475569; font-weight: 500; }
        .dtk-sidebar-title { font-size: 11px; color: #94a3b8; font-weight: 700; margin-bottom: 10px; }
        .cat-item { display: block; padding: 5px 0; font-size: 13px; color: #3b82f6; text-decoration: none; }
        .dtk-modal-footer { padding: 10px 20px; border-top: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #64748b; }
        .dtk-nav-btns button { padding: 4px 12px; border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; cursor: pointer; color: #64748b; font-size: 12px; }
        .dtk-nav-btns button:disabled { opacity: 0.5; cursor: not-allowed; }

        @media (max-width: 767px) {
            .dtk-results-wrapper { flex-direction: column !important; }
            .dtk-results-main { border-right: none !important; border-bottom: 1px solid #f1f5f9 !important; }
            .dtk-search-icon-svg { top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; }
            .dtk-menu-search { position: relative !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; width: 100% !important; }
        }
    </style>

    <script>
    (function() {
        let currentPage = 1;
        let totalPages = 1;
        const modal = document.getElementById('dtk-search-modal');
        const input = document.getElementById('dtk-search-input');
        const footer = document.getElementById('dtk-modal-footer');
        const placeholder = document.getElementById('dtk-placeholder');
        const resultsWrapper = document.getElementById('dtk-results-wrapper');
        let timer;

        function highlight(text, term) {
            if (!term) return text;
            const re = new RegExp("(" + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ")", "gi");
            return text.replace(re, '<span class="dtk-highlight">$1</span>');
        }

        function doSearch(page = 1) {
            const key = input.value.trim();
            if (key.length < 2) {
                placeholder.style.display = 'block';
                resultsWrapper.style.display = 'none';
                footer.style.display = 'none';
                return;
            }
            
            document.getElementById('dtk-post-results').style.opacity = '0.5';
            currentPage = page;
            const ajaxUrl = 'https://damtrungkien.com/wp-admin/admin-ajax.php';
            const fetchUrl = `${ajaxUrl}?action=dtk_search_vfinal&term=${encodeURIComponent(key)}&paged=${currentPage}&_v=${Date.now()}`;

            fetch(fetchUrl)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('dtk-post-results').style.opacity = '1';
                    placeholder.style.display = 'none';
                    resultsWrapper.style.display = 'flex';
                    footer.style.display = 'flex';
                    
                    document.getElementById('dtk-post-results').innerHTML = data.posts.map(p => `
                        <a href="${p.link}" class="search-post-item">
                            <span style="font-size:10px;color:#94a3b8;font-weight:700;text-transform:uppercase;">${p.cat}</span>
                            <span class="dtk-search-post-title">${highlight(p.title, key)}</span>
                        </a>`).join('') || '<div style="padding:50px; text-align:center;">Không tìm thấy bài viết.</div>';
                    
                    document.getElementById('dtk-category-results').innerHTML = data.cats.map(c => `
                        <a href="${c.link}" class="cat-item">${highlight(c.name, key)} (${c.count})</a>`).join('') || '<span style="font-size:12px; color:#ccc;">Không có chuyên mục</span>';
                    
                    document.getElementById('dtk-count-text').innerText = data.total;
                    totalPages = data.max_pages;
                    
                    document.getElementById('dtk-pagination-info').innerText = `Trang ${currentPage}/${totalPages} (${data.total} kết quả)`;
                    
                    document.getElementById('dtk-prev-page').disabled = (currentPage <= 1);
                    document.getElementById('dtk-next-page').disabled = (currentPage >= totalPages);
                    
                    document.querySelector('.dtk-results-main').scrollTop = 0;
                });
        }

        input.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => doSearch(1), 300);
            document.getElementById('dtk-clear-search').style.display = input.value ? 'flex' : 'none';
        });

        document.getElementById('dtk-prev-page').onclick = () => { if (currentPage > 1) doSearch(currentPage - 1); };
        document.getElementById('dtk-next-page').onclick = () => { if (currentPage < totalPages) doSearch(currentPage + 1); };

        document.querySelectorAll('.dtk-tag-text').forEach(tag => {
            tag.onclick = function() {
                input.value = this.innerText;
                input.dispatchEvent(new Event('input'));
                input.focus();
            };
        });

        document.getElementById('dtk-clear-search').onclick = () => {
            input.value = '';
            input.dispatchEvent(new Event('input'));
            input.focus();
        };

        // Đã cập nhật từ phím Space sang Cmd+K / Ctrl+K
        document.addEventListener('keydown', e => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault(); 
                modal.style.display = 'flex'; 
                input.focus();
            }
            if (e.key === 'Escape') modal.style.display = 'none';
        });

        document.addEventListener('click', function(e) {
            if (e.target.closest('.dtk-menu-search')) {
                e.preventDefault();
                modal.style.display = 'flex';
                input.focus();
            }
        });

        document.querySelector('.dtk-modal-overlay').onclick = () => modal.style.display = 'none';
        document.querySelector('.dtk-close-modal').onclick = () => modal.style.display = 'none';
    })();
    </script>
    			<script>
				const lazyloadRunObserver = () => {
					const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
					const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
						entries.forEach( ( entry ) => {
							if ( entry.isIntersecting ) {
								let lazyloadBackground = entry.target;
								if( lazyloadBackground ) {
									lazyloadBackground.classList.add( 'e-lazyloaded' );
								}
								lazyloadBackgroundObserver.unobserve( entry.target );
							}
						});
					}, { rootMargin: '200px 0px 200px 0px' } );
					lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
						lazyloadBackgroundObserver.observe( lazyloadBackground );
					} );
				};
				const events = [
					'DOMContentLoaded',
					'elementor/lazyload/observe',
				];
				events.forEach( ( event ) => {
					document.addEventListener( event, lazyloadRunObserver );
				} );
			</script>
