    <script>
        function openDtkPopup() {
            Swal.fire({
                html: document.getElementById('dtk-popup-template').innerHTML,
                showConfirmButton: false, showCloseButton: true,
                customClass: { popup: 'dtk-swal-popup', container: 'dtk-swal-container', closeButton: 'dtk-swal-close' },
                didOpen: () => {
                    if (window.turnstile) { window.turnstile.render('.cf-turnstile'); }
                    const form = document.getElementById('dtkContactForm');
                    const btn = document.getElementById('dtkSubmitBtn');
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        btn.disabled = true; btn.innerHTML = 'ĐANG GỬI...';
                        const text = `📩 *TƯ VẤN TRIỂN KHAI DỊCH VỤ*\n\n👤 *Khách:* ${document.getElementById('dtk_name').value}\n📞 *SĐT:* ${document.getElementById('dtk_phone').value}\n🛠 *Dịch vụ:* ${document.getElementById('dtk_service').value}\n💬 *Nội dung:* ${document.getElementById('dtk_message').value}`;
                        fetch(`https://api.telegram.org/bot8519823653:AAG84YZMpvY_T23SQkFpkZ1t84Nb8A2pQ0M/sendMessage`, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ chat_id: '1066705829', text: text, parse_mode: 'Markdown' })
                        })
                        .then(res => { 
                            if(res.ok) { 
                                Swal.fire({ 
                                    icon: 'success', 
                                    title: 'Thành công.!', 
                                    text: 'Cảm ơn bạn đã để lại thông tin. Tôi sẽ liên hệ bạn trong thời gian sớm nhất.',
                                    background: 'radial-gradient(circle at top right, #334155, #1e293b)',
                                    iconColor: '#10b981',
                                    confirmButtonText: 'XÁC NHẬN',
                                    confirmButtonColor: '#60a5fa',
                                    customClass: { popup: 'dtk-success-popup' }
                                }); 
                            } else { throw new Error(); } 
                        })
                        .catch(() => { 
                            Swal.fire({ 
                                icon: 'error', 
                                title: 'Lỗi!', 
                                text: 'Vui lòng thử lại sau.',
                                background: '#1e293b',
                                iconColor: '#ef4444',
                                confirmButtonColor: '#475569',
                                customClass: { popup: 'dtk-success-popup' }
                            }); 
                        })
                        .finally(() => { btn.disabled = false; btn.innerHTML = 'GỬI YÊU CẦU'; });
                    });
                }
            });
        }
    </script>
