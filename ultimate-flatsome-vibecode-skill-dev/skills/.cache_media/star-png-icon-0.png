container.home-featured-boxes:after{ content: ""; display: table; clear: both; } } /* Css bo khung phần slidebar - single post */ .penci-sidebar-content.pcsb-boxed-whole { border-radius: 10px; } /* Css bo khung phần slidebar - single post */ /* Css phần bài viết mới trong single post */ .widget ul.side-newsfeed li .side-item .side-item-text h4 a { font-size: 14.5px; line-height: 1.3; } .penci-sidebar-content.style-14 .penci-border-arrow .inner-arrow:before { border-radius: 5px; } /* Css phần bài viết mới trong single post */ /* Css bo góc code-block-pro */ .wp-block-kevinbatdorf-code-block-pro * { border-radius: 5px 5px 0 0; } /* Css cân chỉnh cho text ngang avatar */ .grid-post-box-meta{ display: flex ; align-items: center; } /* Css cân chỉnh cho text ngang avatar */ /* Css bo góc code-block-pro */ /* Css nút load thêm bài viết */ .penci-pagination, #comments_pagination { margin-bottom: 5px; } .penci-pagination.penci-ajax-more a.penci-ajax-more-button { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; max-width: 400px; margin: 10px 10px; border: 1px solid #d1d1d1; border-radius: 4px; background-color: #f9f9f9; color: #333; font-weight: 400; font-size: 15px; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05); } .penci-pagination.penci-ajax-more a.penci-ajax-more-button:hover { background-color: #304257; border-color: #304257; color: #ffffff; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); transform: translateY(-1px); } .penci-pagination.penci-ajax-more a.penci-ajax-more-button svg, .penci-pagination.penci-ajax-more a.penci-ajax-more-button i { transition: transform 0.3s ease; } .penci-pagination.penci-ajax-more a.penci-ajax-more-button:hover svg, .penci-pagination.penci-ajax-more a.penci-ajax-more-button:hover i { transform: rotate(180deg); } /* Css nút load thêm bài viết */ .single-post .wp-block-kevinbatdorf-code-block-pro pre { border-bottom-left-radius: 5px !important; border-bottom-right-radius: 5px !important; } /* Tăng khoảng cách khung copy code và bố cục khác */ .wp-block-kevinbatdorf-code-block-pro { margin-bottom: 15px !important; } /* CSS Khung Terminal */ code { border-color: #eaedf3; background: whitesmoke; padding: 3px; border-radius: 5px; } .header-navbar--scrolled { background-color: #062357; } .post__inner { line-height: 1.97em; } .post__content h3,.post__content h1,.post__content h2,.post__content h4,.post__content h5 { margin-top: 1em; } pre { color: #4b606f; background-color: #f5f5f5; border: 1px solid #b3b3b3; border-radius: 0 0 5px 5px; } .terminal { border-radius: 5px 5px 0 0; position: relative; margin: 25px 0; } .terminal .top { background: #E8E6E8; color: black; padding: 5px; border-radius: 5px 5px 0 0; } .terminal .btns { position: absolute; top: 7px; left: 5px; } .terminal .circle { width: 12px; height: 12px; display: inline-block; border-radius: 15px; margin-left: 2px; border-width: 1px; border-style: solid; } .title{ text-align: center; } .red { background: #EC6A5F; border-color: #D04E42; } .green { background: #64CC57; border-color: #4EA73B; } .yellow{ background: #F5C04F; border-color: #D6A13D; } .clear{clear: both;} .terminal .body { background: black; color: #7AFB4C; padding: 8px; overflow: auto; } .shadow { box-shadow: 0px 0px 10px rgba(0,0,0,.4)} .breadcrumbs__link { color: #0f76bd; } .breadcrumbs { color: #0f75bc; font-weight: bold; } /* CSS Khung Terminal */ /*Bài viết mới nhất - Trang chủ*/ span.avatar-news:after { content: ''; margin: 0; border-right: 0; } span.avatar-news img { border-radius: 50%; object-fit: cover; width: 30px !important; height: 30px !important; } .blog #main li.grid-style.magazine-layout.magazine-2 h2.penci-entry-title.entry-title.grid-title { display: -webkit-box; line-height: 1.3; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; height: 50px; } .blog #main li.grid-style.magazine-layout.magazine-2 a.penci-cat-name:before { content: ''; display: block; /* background-image: url(https://damtrungkien.com/wp-content/uploads/2023/05/star-png-icon-0.png); */ font-family: FontAwesome; display: inline-block; padding-right: 6px; vertical-align: middle; content: "\f005"; } .blog #main li.grid-style.magazine-layout.magazine-2 a.penci-cat-name { border-radius: 4px; background: #38aaca; font-weight: 500; padding: 5px 10px !important; color: #fff; position: absolute; top: -12px; } .blog #main li.grid-style.magazine-layout.magazine-2 { border-radius: 7px; box-shadow: 0px 0px 15px 0px rgb(5 24 33 / 19%) } .blog #main li.grid-style.magazine-layout.magazine-2 .thumbnail { margin-bottom: 0; } .blog #main li.grid-style.magazine-layout.magazine-2 .grid-header-box { padding: 20px 10px !important; position: relative; } /* Size ảnh*/ .penci-image-holder:before { padding-top: 55%; } /*Bài viết mới nhất - Trang chủ*/ /* Custom bảng table trong post*/ .wp-block-table td, .wp-block-table th { background: #124750; color: #fff; } table tr:nth-child(1) td { color: #fff; } table { border-collapse: collapse; border: 1px solid #ccc; border-spacing: 0; } table td { border: 1px solid #124750; } /* Custom bảng table trong post*/ /*=== 404 page =====*/ .page_404 { padding: 40px 0; background: #fff; font-family: "Arvo", serif; } .page_404 img { width: 100%; } .four_zero_four_bg { background-image: url(/wp-content/uploads/2024/07/404-page.gif); height: 400px; background-position: center; } .four_zero_four_bg h1 { font-size: 40px; } .four_zero_four_bg h3 { font-size: 80px; } .link_404 { color: #fff !important; padding: 10px 20px; background: #39ac31; margin: 20px 0; display: inline-block; } .contant_box_404 { margin-top: -50px; } /*=== 404 page =====*/  /*=== css bo ảnh single post =====*/ .post-entry img, .post-entry img, .container.has-banner .header-banner img { border-radius: 5px; } .penci-image-holder{ border-top-left-radius: 5px; border-top-right-radius: 5px; } .penci-image-holder.small-fix-size { width: 120px; border-radius: 5px; } /*=== css bo ảnh single post =====*/ /* CSS Dịch vụ của chúng tôi - WordPress A - Z*/ .post-entry h3 { margin-top: 17px;} .penci-border-arrow .inner-arrow, .penci-sidebar-content.style-12 .penci-border-arrow .inner-arrow, .penci-sidebar-content.style-14 .penci-border-arrow .inner-arrow:before, .penci-sidebar-content.style-13 .penci-border-arrow .inner-arrow, .penci-sidebar-content .penci-border-arrow .inner-arrow, .penci-sidebar-content.style-15 .penci-border-arrow .inner-arrow { background-color: #273647; } .container.penci-breadcrumb { display: none; } .elementor-8236 .elementor-element.elementor-element-2d9432b7 .elementskit-single-pricing .elementskit-pricing-price-wraper.has-tag .elementskit-pricing-price sup.currency { font-family: "Archivo", Sans-serif; font-size: 40px; display: none; vertical-align: baseline; } .penci-single-style-10 .penci-post-image-wrapper { background-color: #273647; } .penci-home-popular-posts .penci-owl-carousel-slider .penci-image-holder:before { padding-top: 65%; } .penci-home-popular-posts{ margin-bottom: 20px !important; } .related-home .subtitle-wp { color: #F06292; font-size: 10px; font-weight: 800; } .related-home h3.entry-title { margin-top: 5px; display: -webkit-box; line-height: 1.3; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; height: 45px; } .related-home h3.entry-title a { color: #fff; } .related-home { position: relative; } .sub-text { position: absolute; float: left; text-align: left; bottom: 16px; background: #0006; width: 93%; padding: 10px; height: 75px; } .line-heading { border-top: 1px solid #022847; margin-bottom: 10px; width: 80px; text-align: center; margin: 10px auto 20px; } .title-heading { text-align: center; } .title-heading h4 { color: #022847; font-size: 30px; font-style: italic; } div#navigation-sticky-wrapper, .fea-box-img, a.related-thumb { border-radius: 5px; } /* CSS Dịch vụ của chúng tôi - WordPress A - Z*/ /* CSS Bo khung mục lục */ .penci-toc-wrapper.penci-toc-default { border-radius: 6px; } /* CSS Bo khung mục lục */ /* CSS slide bar banner dịch vụ */ .penci-sidebar-content img { border-radius: 10px; } /* CSS slide bar banner dịch vụ */ /* CSS ẩn bài viết trước - sau trong single post */ .post-pagination { overflow: hidden; margin: 0; padding: 15px 0 15px; border-top: 1px solid #DEDEDE; display: none; } /* CSS ẩn bài viết trước - sau trong single post */ /* CSS ẩn nút search Lam đã làm - Ẩn nút Menu ở thanh Menu PC */ .penci-menuhbg-toggle { display: none; } .search-box { display: none; } /* CSS ẩn nút search Lam đã làm - Ẩn nút Menu ở thanh Menu PC */ /* CSS Fom liên hệ*/ .form-contact input.wpcf7-form-control.has-spinner.wpcf7-submit { background: #273647 !important; border-color: #273647 !important; color: #fff; } .form-contact input.wpcf7-form-control.has-spinner.wpcf7-submit:hover { border-color: #d67a0c!important; background: #d67a0c!important; } .form-contact input.wpcf7-form-control, .form-contact textarea.wpcf7-form-control{ border: none; border-bottom: 1px solid rgba(255,255,255,.2); padding: 10px; color: #fff; } .form-contact input.wpcf7-form-control.has-spinner.wpcf7-submit { background: #54595F!important; border-color: #54595F!important; border-radius: 5px; color: #fff; } /*.post-entry p, .wpb_text_column p, .woocommerce .page-description p { margin-bottom: 1px; }*/ li.elementor-icon-list-item a { text-decoration: none !important; } span.elementor-icon-list-text:hover { color: #2196f3 !important; } .wpcf7 form.sent .wpcf7-response-output { border-style: none; font-size: 1.2rem; } #wpcf7-f4019-p1455-o1 input::placeholder, #wpcf7-f4019-p1455-o1 textarea::placeholder { color: #fff !important; } /* CSS Fom liên hệ*/ .penci-block-vc .style-8.penci-border-arrow .inner-arrow { background-repeat: no-repeat; background-size: auto; } .penci-block-vc .penci-border-arrow .inner-arrow { background-color: #000000; } .penci-block-vc .style-2.penci-border-arrow:after{ border-t