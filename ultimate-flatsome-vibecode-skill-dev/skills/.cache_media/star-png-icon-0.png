.penci-border-arrow.penci-homepage-title.penci-magazine-title.style-4 h3::first-letter {
    color: #1975ba !important;
}

/* 3. VÔ HIỆU HÓA hoàn toàn gạch xanh dương mặc định của theme (:before) */
.penci-border-arrow.penci-homepage-title.penci-magazine-title.style-4::before,
.penci-border-arrow.penci-homepage-title.penci-magazine-title.style-4 .inner-arrow::before,
