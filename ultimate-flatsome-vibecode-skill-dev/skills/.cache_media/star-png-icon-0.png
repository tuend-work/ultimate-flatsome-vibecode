    background: linear-gradient(135deg, #1c7a93, #5bbad0);
    box-shadow: 0 4px 10px rgba(33, 147, 176, 0.3);
    color: #ffffff;
    transform: translateY(-1px);
}</style><style class="wpcode-css-snippet">/* Tổng thể khu vực tiêu đề */
.penci-border-arrow.penci-homepage-title.penci-magazine-title.style-4 {
    border: none !important; 
    position: relative;
    display: flex;
    align-items: center;
    padding-top: 25px;
    margin-bottom: 12px;
    background: none !important;
}


/* 1. Tạo đường kẻ gạch dưới màu xanh lá mỏng và mờ dần (Đúng mẫu) */
/* Sử dụng thuộc tính sau cùng để không bị đè bởi các thành phần khác */
.penci-border-arrow.penci-homepage-title.penci-magazine-title.style-4::after {
    content: "" !important;
    position: absolute;
    bottom: -10px; /* Đã tăng khoảng cách từ 0 xuống -10px */
    left: 0;
    width: 250px; 
    height: 4px; /* Độ mảnh tinh tế 1px */
    background: linear-gradient(to right, #4c7ea6 0%, rgba(120, 192, 99, 0) 100%) !important;
    display: block !important;
}

