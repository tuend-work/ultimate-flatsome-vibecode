    }
}

/* Hiển thị icon search trên Mobile (màn hình nhỏ hơn hoặc bằng 1024px) */
@media (max-width: 1024px) {
    .pcheader-icon {
        display: inline-block; /* Hoặc block tùy theo layout của bạn */
    }
}

/* Giữ nguyên các thuộc tính cũ của bạn */
